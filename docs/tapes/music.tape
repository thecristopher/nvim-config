# The now playing panel, needs a song playing in Music.app or Cider while recording
Output images/demo/music.gif
Source docs/tapes/settings.tape
Hide
Type `cd "$DEMO_REPO" && clear && DEMO_MUSIC=1 nvim --cmd "luafile $DEMO_LUA" lua/init.lua`
Enter
Sleep 5s
Show
Sleep 1500ms
Type " o"
Sleep 3500ms
Type "q"
Sleep 1s
